# ── MediPredict ML service (FastAPI → Render) ──
# The service reads no env vars at runtime; everything is flags/paths.
# Documented here so deploys don't guess.

# Port is passed by the platform (Render injects $PORT; Dockerfile CMD uses 8000,
# override at deploy time with: uvicorn main:app --host 0.0.0.0 --port $PORT)
PORT=8000

# Host-only: where eng.traineddata lives when the system tesseract lacks it.
# Not needed in Docker (tesseract-ocr-eng is baked into the image).
# TESSDATA_PREFIX=/home/<you>/.tessdata
