# ── MediPredict backend (Express → Render) ──
# Copy to Backend/.env locally. On Render, set these in the dashboard / render.yaml.
# Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (production) or local mongod (dev)
MONGO_URI=mongodb://127.0.0.1:27017/medipredict
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medipredict

# JWT signing key — generate: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated allowlist of frontend origins (required in production)
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://medipredict.vercel.app

# Cookie policy: lax locally; "none" is required for Vercel→Render cross-site cookies
# COOKIE_SAME_SITE=lax

# Python ML microservice (full origin, no trailing slash)
ML_SERVICE_URL=http://127.0.0.1:8000
# ML_SERVICE_URL=https://medipredict-ml.onrender.com

# Optional bearer forwarded to the ML service (ML currently accepts without it)
ML_SERVICE_TOKEN=
